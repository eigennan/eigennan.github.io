---
import FunReadout from "./FunReadout.astro"
import FunSelect from "./FunSelect.astro"
import FunSlider from "./FunSlider.astro"
import FunStage from "./FunStage.astro"
import FunToggle from "./FunToggle.astro"

const curves = [
  { value: "circle", label: "Circle" },
  { value: "ellipse", label: "Ellipse" },
  { value: "rose", label: "Three-petal rose" },
  { value: "lissajous", label: "Lissajous figure" },
]

const heights = [
  { value: "one", label: "f = 1  (so the area is the length)" },
  { value: "linear", label: "f = 2 + x" },
  { value: "bump", label: "f = 1 + x² + y²" },
  { value: "wave", label: "f = 1.6 + sin(3x)" },
]
---

<FunStage
  slug="the-curtain"
  ratio="4 / 3"
  narrowRatio="1 / 1"
  label="A curve on the ground plane with a vertical fence standing along it, as tall at each point as the function is there."
>
  <Fragment slot="controls">
    <FunSelect name="curve" label="Path on the ground" options={curves} />
    <FunSelect name="height" label="Height function" options={heights} />
    <FunSlider
      name="ribs"
      label="Fence posts"
      min={6}
      max={90}
      step={1}
      value={28}
      display="28"
    />
    <div class="fun-toggles">
      <FunToggle name="surface" label="The surface above" />
      <FunToggle name="spin" label="Spin" />
    </div>
    <FunReadout
      rows={[
        { name: "area", label: "area of the fence  ∫ f ds" },
        { name: "length", label: "length of the path  ∫ ds" },
        { name: "naive", label: "∫ f dt, ignoring speed" },
        { name: "average", label: "average height" },
      ]}
    />
    <p class="fun-note">
      With f = 1 the fence is one unit tall everywhere, so its area is just the
      path's length.
    </p>
  </Fragment>

  <Fragment slot="notes">
    <h2>What you're looking at</h2>
    <p>
      Walk a path across the ground and, at every step, put up a fence panel as
      tall as the function is above you. The total area of that fence is the
      <strong>scalar line integral ∫ f ds</strong>.
    </p>
    <p>
      This is a different animal from the work integral. There you asked how
      much a <em>vector</em> field pushed you along, and the direction you
      walked mattered enormously — reverse it and the answer flipped sign. Here
      you're adding up a plain number times a length of path. Walk it backwards
      and nothing changes at all; the fence is the same fence.
    </p>
    <p>
      The <strong>ds</strong> is doing real work, and the third readout shows
      what happens without it. Integrating f dt weights each point by how much
      <em>parameter</em>
      you spent there instead of how much <em>ground</em> you covered — so a
      stretch traced slowly gets counted far too heavily. Since ds = |r′(t)| dt,
      the speed is exactly the correction, and the two numbers only agree when
      the curve happens to be traced at unit speed.
    </p>
    <p>
      Set f = 1 and the fence is a unit-height ribbon, so its area is the path's
      length — the arclength formula falling out as the simplest possible case.
      Divide the area by the length instead and you get the honest average of f
      along the path, which is what "average" ought to mean when the steps
      aren't evenly spaced.
    </p>
  </Fragment>
</FunStage>

<script>
  import { registerFunApp } from "@/lib/fun/canvas"
  import {
    bindSelect,
    bindSlider,
    bindToggle,
    disposeAll,
  } from "@/lib/fun/controls"
  import { type Curve2, type Scalar2, fmt, hypot } from "@/lib/fun/numeric"
  import {
    type Scene3DHandle,
    addLights,
    disposeChildren,
    makeAxes,
    mountScene3D,
  } from "@/lib/fun/scene3d"
  import { parametricMesh } from "@/lib/fun/surface3d"

  const CURVES: Record<string, Curve2> = {
    circle: (t) => [Math.cos(t), Math.sin(t)],
    ellipse: (t) => [1.5 * Math.cos(t), 0.8 * Math.sin(t)],
    rose: (t) => [
      Math.cos(3 * t) * Math.cos(t) * 1.4,
      Math.cos(3 * t) * Math.sin(t) * 1.4,
    ],
    lissajous: (t) => [1.4 * Math.sin(2 * t), 1.1 * Math.sin(3 * t)],
  }

  const HEIGHTS: Record<string, Scalar2> = {
    one: () => 1,
    linear: (x) => 2 + x,
    bump: (x, y) => 1 + x * x + y * y,
    wave: (x) => 1.6 + Math.sin(3 * x),
  }

  const T_MAX = Math.PI * 2
  const PANELS = 3000

  registerFunApp('[data-fun-app="the-curtain"]', (root) => {
    const glCanvas = root.querySelector<HTMLCanvasElement>("[data-fun-canvas]")
    if (!glCanvas) return () => {}

    let stage: Scene3DHandle | null = null
    let disposed = false

    const curve = bindSelect(root, "curve", refresh)
    const height = bindSelect(root, "height", refresh)
    const ribs = bindSlider(root, "ribs", {
      format: (v) => String(v),
      onInput: refresh,
    })
    const showSurface = bindToggle(root, "surface", refresh)
    const spin = bindToggle(root, "spin", (on) => {
      stage?.setAnimating(on)
      refresh()
    })

    const path = () => CURVES[curve.value] ?? CURVES.circle
    const f = () => HEIGHTS[height.value] ?? HEIGHTS.one

    function setReadout(name: string, value: string) {
      const el = root.querySelector<HTMLElement>(`[data-fun-readout="${name}"]`)
      if (el) el.textContent = value
    }

    /** Speed |r′(t)|, which is the whole difference between ds and dt. */
    function speed(at: Curve2, t: number): number {
      const h = 1e-5
      const [ax, ay] = at(t + h)
      const [bx, by] = at(t - h)
      return hypot((ax - bx) / (2 * h), (ay - by) / (2 * h))
    }

    function buildScene(handle: Scene3DHandle) {
      const { three, scene, palette } = handle
      const at = path()
      const evaluate = f()

      addLights(three, scene, 0.95)
      scene.add(makeAxes(three, 2.2, palette["muted-foreground"], 2.6))

      // The curtain: a ruled surface between the ground curve and the graph.
      const { geometry } = parametricMesh(
        three,
        (t, s) => {
          const [x, y] = at(t)
          return [x, y, s * evaluate(x, y)]
        },
        { uMin: 0, uMax: T_MAX, vMin: 0, vMax: 1 },
        260,
        1,
      )
      scene.add(
        new three.Mesh(
          geometry,
          new three.MeshStandardMaterial({
            color: palette.accent,
            roughness: 0.85,
            side: three.DoubleSide,
            transparent: true,
            opacity: 0.72,
            polygonOffset: true,
            polygonOffsetFactor: 2,
            polygonOffsetUnits: 2,
          }),
        ),
      )

      // The posts, so the fence reads as built from strips of width ds.
      const posts: number[] = []
      const count = Math.round(ribs.value)
      for (let i = 0; i <= count; i++) {
        const [x, y] = at((i / count) * T_MAX)
        posts.push(x, y, 0, x, y, evaluate(x, y))
      }
      const postGeometry = new three.BufferGeometry()
      postGeometry.setAttribute(
        "position",
        new three.Float32BufferAttribute(posts, 3),
      )
      scene.add(
        new three.LineSegments(
          postGeometry,
          new three.LineBasicMaterial({
            color: palette.foreground,
            transparent: true,
            opacity: 0.6,
          }),
        ),
      )

      // The ground curve and the top edge.
      for (const lift of [0, 1]) {
        const points: number[] = []
        for (let i = 0; i <= 700; i++) {
          const [x, y] = at((i / 700) * T_MAX)
          points.push(x, y, lift * evaluate(x, y))
        }
        const lineGeometry = new three.BufferGeometry()
        lineGeometry.setAttribute(
          "position",
          new three.Float32BufferAttribute(points, 3),
        )
        scene.add(
          new three.Line(
            lineGeometry,
            new three.LineBasicMaterial({
              color: lift === 0 ? palette.destructive : palette.primary,
            }),
          ),
        )
      }

      if (showSurface.on) {
        const { geometry: sheet } = parametricMesh(
          three,
          (x, y) => [x, y, evaluate(x, y)],
          { uMin: -1.8, uMax: 1.8, vMin: -1.8, vMax: 1.8 },
          60,
          60,
        )
        scene.add(
          new three.Mesh(
            sheet,
            new three.MeshStandardMaterial({
              color: palette["muted-foreground"],
              roughness: 0.95,
              side: three.DoubleSide,
              transparent: true,
              opacity: 0.22,
              depthWrite: false,
            }),
          ),
        )
      }

      // ∫ f ds, ∫ ds and the naive ∫ f dt, all by midpoint on the same grid.
      const dt = T_MAX / PANELS
      let area = 0
      let length = 0
      let naive = 0
      for (let i = 0; i < PANELS; i++) {
        const t = (i + 0.5) * dt
        const [x, y] = at(t)
        const v = speed(at, t)
        const value = evaluate(x, y)
        area += value * v * dt
        length += v * dt
        naive += value * dt
      }

      setReadout("area", fmt(area, 4))
      setReadout("length", fmt(length, 4))
      setReadout("naive", fmt(naive, 4))
      setReadout("average", length > 1e-9 ? fmt(area / length, 4) : "—")
    }

    function refresh() {
      if (!stage || disposed) return
      disposeChildren(stage.scene)
      buildScene(stage)
      stage.redraw()
    }

    void mountScene3D({
      canvas: glCanvas,
      orbit: { azimuth: -1.05, elevation: 0.34, distance: 6.4 },
      distanceRange: [3, 18],
      build: buildScene,
      update(handle, elapsed) {
        if (spin.on) handle.orbit.azimuth = -1.05 - elapsed * 0.3
      },
    })
      .then((handle) => {
        if (disposed) {
          handle.dispose()
          return
        }
        stage = handle
        if (spin.on) handle.setAnimating(true)
      })
      .catch(() => {
        // No WebGL: the four integrals still tell the story.
      })

    const disposeControls = disposeAll([curve, height, ribs, showSurface, spin])

    return () => {
      disposed = true
      disposeControls()
      stage?.dispose()
    }
  })
</script>
