---
interface Props {
  name: string
  label: string
  min: number
  max: number
  step: number
  value: number
  /** Initial readout text; the app's script keeps it current after that. */
  display?: string
}

const { name, label, min, max, step, value, display } = Astro.props
const id = `fun-${name}`
---

<div class="fun-control">
  <div class="fun-control-head">
    <label class="fun-control-label" for={id}>{label}</label>
    <output class="fun-control-value" for={id} data-fun-output={name}>
      {display ?? String(value)}
    </output>
  </div>
  <input
    class="fun-range"
    type="range"
    id={id}
    data-fun-input={name}
    min={min}
    max={max}
    step={step}
    value={value}
  >
</div>
