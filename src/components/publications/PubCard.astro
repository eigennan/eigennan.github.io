---
import type { ProcessedPublication } from "@/types"

import { slugify } from "@/lib/string-manipulation"
import Badge from "@/components/base/Badge.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import Card from "@/components/base/card/Card.astro"
import CardContent from "@/components/base/card/CardContent.astro"
import CardDescription from "@/components/base/card/CardDescription.astro"
import CardFooter from "@/components/base/card/CardFooter.astro"
import CardMeta from "@/components/base/card/CardMeta.astro"
import CardTitle from "@/components/base/card/CardTitle.astro"

interface Props {
  pub: ProcessedPublication
}

const { pub } = Astro.props
const keywords = pub.keywords
const hasBadges = pub.award || (keywords && keywords.length > 0)
---

<Card
  href={pub.mainUrl}
  label={`Publication: ${pub.title}`}
  class="publication-card"
  data-pub-year={pub.year ?? ""}
  data-pub-selected={pub.selected ? "true" : "false"}
  data-pub-author-position={pub.authorPosition ?? Infinity}
  data-pub-keywords={pub.expandedKeywords?.map((k) => slugify(k)).join(",") ?? ""}
  data-has-image={pub.image ? "true" : "false"}
>
  {pub.image && (
      <img
        src={pub.image}
        alt={pub.imageAlt ?? `Visual summary for “${pub.title}”`}
        width="1200"
        height="630"
        loading="lazy"
        decoding="async"
        class="cover-image"
      />
    )}

  <CardContent class="publication-card-content">
    <CardTitle>{pub.title}</CardTitle>

    <CardDescription class="publication-authors">
      <span set:html={pub.authorData.displayFirstAuthors} />
      {pub.authorData.hasMore && (
          <span>{` …and ${pub.authorData.hiddenCount} more… `}</span>
        )}
      {pub.authorData.displayLastAuthors && pub.authorData.hasMore && (
          <span>
            ,
            <span set:html={pub.authorData.displayLastAuthors} />
          </span>
        )}
    </CardDescription>

    {(pub.publisher || pub.year) && (
        <CardMeta>
          {pub.publisher && (
            <span class="publication-publisher">{pub.publisher}</span>
          )}
          {pub.publisher && pub.year && <span> • </span>}
          {pub.year && <span>{pub.year}</span>}
        </CardMeta>
      )}

    {hasBadges && (
        <CardFooter class="publication-card-badges">
          {pub.award && <Badge variant="success">🏆 {pub.award}</Badge>}
          {keywords && keywords.map((keyword: string) => (
              <TaxonomyChip label={keyword} static />
            ))}
        </CardFooter>
      )}
  </CardContent>
</Card>

<style>
  .publication-card:hover {
    background-color: oklch(from var(--muted) l c h / 0.5);
  }

  .publication-card {
    position: relative;
    overflow: hidden;
  }

  .publication-card-content {
    position: relative;
    z-index: 1;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .publication-card[data-has-image="true"] .publication-card-content {
    @media (width >= 48rem) {
      max-inline-size: 80%;
    }

    @media (width < 48rem) {
      padding-block-start: 6rem;
    }
  }

  .publication-card :global([data-slot="card-title"]) {
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .publication-card:hover :global([data-slot="card-title"]) {
    color: var(--primary);
  }

  .publication-card-badges {
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .publication-card-badges::-webkit-scrollbar {
    display: none;
  }

  .cover-image {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 0;
    inline-size: 60%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0.3;
    mask: linear-gradient(to right, transparent 0%, black 100%);
    transition: opacity var(--motion-duration-slow) var(--motion-ease);
  }

  .publication-card:hover .cover-image {
    opacity: 0.5;
  }

  @media (width < 48rem) {
    .cover-image {
      inline-size: 100%;
      block-size: 66%;
      mask: linear-gradient(to top, transparent 0%, black 100%);
    }
  }

  .publication-publisher {
    font-weight: var(--font-weight-bold);
  }

  /* The only :global that has to stay: .author-highlight is injected through
     set:html at runtime, so it never receives a scope attribute. */
  .publication-authors :global(.author-highlight) {
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
    text-decoration-color: var(--primary);
  }
</style>
