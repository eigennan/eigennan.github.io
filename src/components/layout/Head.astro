---
import { ClientRouter } from "astro:transitions"

import { PROFILE, SITE } from "@site-config"
import type { BreadcrumbItem } from "@/components/layout/Breadcrumbs.astro"

interface Props {
  title?: string
  description?: string
  image?: string | URL
  noindex?: boolean
  type?: "website" | "article" | "profile"
  publishedTime?: Date
  modifiedTime?: Date
  author?: string
  tags?: string[]
  section?: string
  breadcrumbs?: BreadcrumbItem[]
}

const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_MEASUREMENT_ID

const {
  title,
  description = SITE.description,
  image,
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  section,
  breadcrumbs,
} = Astro.props

// SEO title optimization
const fullTitle = title
  ? title === SITE.title
    ? SITE.title // Don't duplicate if title is already site title
    : `${title} - ${SITE.title} - ${PROFILE.tagline}`
  : `${SITE.title} - ${PROFILE.tagline}`

// Trim title to approximately 60 characters for SEO, breaking on a word
// boundary so the last word isn't sliced in half.
const seoTitle = (() => {
  if (fullTitle.length <= 60) return fullTitle
  const clipped = fullTitle.slice(0, 57)
  const lastSpace = clipped.lastIndexOf(" ")
  const trimmed = (lastSpace > 0 ? clipped.slice(0, lastSpace) : clipped)
    // drop a dangling connector/punctuation so it doesn't read "... Waves &…"
    .replace(/[\s\-–—&,:;.]+$/, "")
  return `${trimmed}…`
})()

const socialImage = (() => {
  // 1. If no image, use configured page/post preview image
  if (!image) {
    return new URL(
      type === "article" ? SITE.defaultPostImage : SITE.defaultPageImage,
      Astro.site,
    )
  }
  // 2. If image is already a URL object, use it directly
  if (image instanceof URL) {
    return image
  }
  // 3. If image is a string
  if (typeof image === "string") {
    // Check if it's a remote link (starts with http:// or https://)
    if (image.startsWith("http")) {
      return image
    }
    // For other strings, prepend Astro.site
    return new URL(image, Astro.site)
  }
})()

// Canonical URL. Must include the current path: a site-root-only value makes
// every page self-canonicalize to "/", which asks Google to drop them all.
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? SITE.href,
).toString()

// The research vocabulary this site wants to be discoverable for. Kept in one
// ordered list so meta, prose, and structured data all agree; consistent
// repetition of the same entity terms is what links them to the name.
const KNOWS_ABOUT = [
  "Applied mathematics",
  "Dynamical systems",
  "Nonlinear waves",
  "Coherent structures",
  "Spiral waves",
  "Pattern formation",
  "Dynamics of PDEs",
  "Partial differential equations",
  "Geometric flows",
  "Curvature flow",
  "Reaction-diffusion systems",
  "Numerical methods",
  "Numerical continuation",
  "Mathematical biology",
  "Computational biology",
  "Mathematical neuroscience",
  "Computational neuroscience",
  "Equivariant homotopy theory",
]

// PROFILE.links values are either a bare URL string or { href }. Only absolute
// URLs belong in sameAs -- it asserts "this is the same entity elsewhere", so a
// local path like /doc/short_cv.pdf would be meaningless to a consumer.
const sameAs = Object.values(PROFILE.links ?? {})
  .map((link) => (typeof link === "string" ? link : link?.href))
  .filter((href): href is string => Boolean(href?.startsWith("http")))

const personId = new URL("#person", SITE.href).toString()

const person = {
  "@type": "Person",
  "@id": personId,
  name: PROFILE.name,
  url: SITE.href,
  jobTitle: "Ph.D. Candidate in Mathematics",
  description: SITE.description,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "University of Minnesota",
    url: "https://twin-cities.umn.edu/",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of California, Los Angeles",
    url: "https://www.ucla.edu/",
  },
  knowsAbout: KNOWS_ABOUT,
  ...(PROFILE.email && { email: PROFILE.email }),
  ...(sameAs.length > 0 && { sameAs }),
}

// The homepage is a profile of a person; articles are BlogPosting; everything
// else is a WebPage. (WebSite describes the site as a whole, not a subpage.)
const isHome = new URL(canonicalURL).pathname === "/"
const pageType =
  type === "article" ? "BlogPosting" : isHome ? "ProfilePage" : "WebPage"

const pageEntity = {
  "@type": pageType,
  "@id": canonicalURL,
  name: seoTitle,
  description: description,
  url: canonicalURL,
  image: socialImage?.toString(),
  inLanguage: SITE.locale.lang,
  isPartOf: {
    "@type": "WebSite",
    "@id": new URL("#website", SITE.href).toString(),
    name: SITE.title,
    url: SITE.href,
  },
  // ProfilePage describes its subject; the others were authored by them.
  ...(pageType === "ProfilePage"
    ? { mainEntity: { "@id": personId } }
    : {
        author: author
          ? { "@type": "Person", name: author }
          : { "@id": personId },
      }),
  ...(pageType !== "ProfilePage" && { publisher: { "@id": personId } }),
  ...(publishedTime && { datePublished: publishedTime.toISOString() }),
  ...(modifiedTime && { dateModified: modifiedTime.toISOString() }),
  ...(type === "article" && section && { articleSection: section }),
  ...(tags.length > 0 && { keywords: tags.join(", ") }),
}

// Breadcrumbs are rendered visibly by Breadcrumbs.astro but had no markup
// behind them. Position is 1-based and includes the implicit Home crumb.
const breadcrumbEntity =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: SITE.href,
          },
          ...breadcrumbs.map((crumb, index) => ({
            "@type": "ListItem",
            position: index + 2,
            name: crumb.label,
            ...(crumb.href && {
              item: new URL(crumb.href, SITE.href).toString(),
            }),
          })),
        ],
      }
    : null

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    pageEntity,
    ...(breadcrumbEntity ? [breadcrumbEntity] : []),
  ],
}
---

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  >
  <meta name="generator" content={Astro.generator}>

  <title>{seoTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <meta name="robots" content="index, follow" />}

  {author && <meta name="author" content={author} />}
  {publishedTime && <meta name="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta name="article:modified_time" content={modifiedTime.toISOString()} />}
  {section && <meta name="article:section" content={section} />}
  {tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={SITE.title}>
  <meta property="og:title" content={seoTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={socialImage}>
  <meta property="og:image:alt" content={title || SITE.title}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:locale" content={SITE.locale.lang}>
  {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  {author && <meta property="article:author" content={author} />}
  {section && <meta property="article:section" content={section} />}
  {tags.map((tag) => <meta property="article:tag" content={tag} />)}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title || SITE.title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={socialImage}>
  <meta name="twitter:image:alt" content={title || SITE.title}>

  <meta
    name="theme-color"
    content="#0e141f"
    media="(prefers-color-scheme: dark)"
  >
  <meta
    name="theme-color"
    content="#f9f5eb"
    media="(prefers-color-scheme: light)"
  >
  <meta name="color-scheme" content="light dark">

  <meta name="HandheldFriendly" content="True">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content={SITE.title}>
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  >

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", SITE.href).href}
  >

  {googleAnalyticsId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
      <script is:inline define:vars={{ googleAnalyticsId }}>
        window.dataLayer = window.dataLayer || []
        function gtag() {
          dataLayer.push(arguments)
        }
        gtag("js", new Date())
        gtag("config", googleAnalyticsId)
      </script>
    </>
  )}

  <ClientRouter />
  <script is:inline define:vars={{ siteLocale: SITE.locale.lang }}>
    window.__SITE_LOCALE__ = siteLocale

    function loadZoomAssets() {
      if (!document.querySelector("link[data-medium-zoom-styles]")) {
        const styles = document.createElement("link")
        styles.rel = "stylesheet"
        styles.href = "/styles/zoom.css"
        styles.dataset.mediumZoomStyles = "true"
        document.head.append(styles)
      }

      if (window.mediumZoom) return Promise.resolve()
      if (window.__mediumZoomPromise) return window.__mediumZoomPromise

      /* A rejected promise left in place would be awaited by every later
         attempt, so one offline moment would disable zoom for the rest of the
         session even after the network recovers. Clear it, and drop the dead
         script tag, so the next navigation can retry. */
      window.__mediumZoomPromise = new Promise((resolve, reject) => {
        const script = document.createElement("script")
        script.src =
          "https://cdn.jsdelivr.net/npm/medium-zoom@1.1.0/dist/medium-zoom.min.js"
        script.async = true
        script.addEventListener("load", resolve, { once: true })
        script.addEventListener(
          "error",
          () => {
            script.remove()
            reject(new Error("medium-zoom failed to load"))
          },
          { once: true },
        )
        document.head.append(script)
      }).catch((error) => {
        window.__mediumZoomPromise = null
        throw error
      })

      return window.__mediumZoomPromise
    }

    async function initializeImageZoom() {
      const images = document.querySelectorAll(
        "main img:not(a img):not(.card img)",
      )
      if (!images.length) return

      try {
        await loadZoomAssets()
        window.__mediumZoomInstance?.detach()
        window.__mediumZoomInstance = window.mediumZoom(images, {
          margin: 24,
          scrollOffset: 40,
        })
      } catch {
        // Images remain fully usable if the optional enhancement cannot load.
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeImageZoom, {
        once: true,
      })
    } else {
      initializeImageZoom()
    }
    document.addEventListener("astro:after-swap", initializeImageZoom)
  </script>

  <slot />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
</head>
