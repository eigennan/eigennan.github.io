---
import { getCollection } from "astro:content"

import type { ProcessedPublication } from "@/types"

import { PROFILE } from "@site-config"
import { formatCount } from "@/lib/plural"
import { loadAllPublications } from "@/lib/publications/loader"
import { slugify } from "@/lib/string-manipulation"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Dropdown from "@/components/base/Dropdown.astro"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"
import Section from "@/components/layout/Section.astro"
import PresentationTimeline from "@/components/presentations/PresentationTimeline.astro"
import PubCard from "@/components/publications/PubCard.astro"

import "@/styles/chip-filter.css"

const ggScholarUrl =
  typeof PROFILE.links.googleScholar === "object"
    ? PROFILE.links.googleScholar?.href
    : PROFILE.links.googleScholar

const { publicationsByYear, years, allPublicationsFlat, allKeywords } =
  await loadAllPublications()

const equalContributionNote = [
  ...new Set(
    allPublicationsFlat.flatMap((pub) =>
      pub.equalContributionNote ? pub.equalContributionNote.split(". ") : [],
    ),
  ),
].join(". ")

const presentations = await getCollection("presentations")

// ScholarlyArticle markup for each publication. The loader already parses
// authors, abstracts, and identifiers; the cards only ever render a subset,
// so this is the only place a crawler can see the full record.
const stripHtml = (value: string) =>
  value
    .replace(/<[^>]*>/g, "")
    .replace(/\s+/g, " ")
    .replace(/,\s*$/, "")
    .trim()

const publicationSchema = {
  "@context": "https://schema.org",
  "@graph": allPublicationsFlat.map((pub) => {
    const url = pub.mainUrl ?? ""
    const arxiv = url.match(/arxiv\.org\/abs\/([^\s/?#]+)/i)?.[1]
    const doi = url.match(/doi\.org\/(.+)$/i)?.[1]

    return {
      "@type": "ScholarlyArticle",
      headline: pub.title,
      name: pub.title,
      author: [
        stripHtml(pub.authorData.displayFirstAuthors),
        pub.authorData.hasMore ? stripHtml(pub.authorData.hiddenAuthors) : "",
        stripHtml(pub.authorData.displayLastAuthors ?? ""),
      ]
        .filter(Boolean)
        .join(", ")
        .split(/,\s*/)
        .filter(Boolean)
        .map((name) => ({ "@type": "Person", name })),
      ...(pub.year && { datePublished: pub.year.toString() }),
      ...(pub.publisher && {
        publisher: { "@type": "Organization", name: pub.publisher },
        isPartOf: { "@type": "Periodical", name: pub.publisher },
      }),
      ...(pub.abstract && { abstract: stripHtml(pub.abstract) }),
      ...(pub.keywords.length > 0 && { keywords: pub.keywords.join(", ") }),
      ...(url && { url }),
      ...(doi
        ? {
            identifier: {
              "@type": "PropertyValue",
              propertyID: "DOI",
              value: doi,
            },
          }
        : arxiv
          ? {
              identifier: {
                "@type": "PropertyValue",
                propertyID: "arXiv",
                value: arxiv.replace(/v\d+$/, ""),
              },
            }
          : {}),
    }
  }),
}
---

<CommonLayout
  title="Research"
  description="Publications, preprints, and conference presentations on spiral waves, pattern formation, geometric flows, and reaction-diffusion systems."
  breadcrumbs={[{ label: "Research", icon: "research" }]}
  prose={false}
  celestial
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(publicationSchema)}
  />

  {ggScholarUrl && (
      <p class="publication-intro">
        See my full publication list on{" "}
        <Link href={ggScholarUrl} external underline class="publication-scholar-link">
          Google Scholar
        </Link>
        .
      </p>
    )}

  <!-- Controls: sort dropdown + tag filter bar -->
  <div class="pub-controls">
    <div class="pub-sort">
      <Dropdown align="start" id="pub-sort-dropdown">
        <button
          slot="trigger"
          data-dropdown-trigger
          class="pub-sort-trigger"
          aria-label="Sort publications"
        >
          <Icon name="mingcute:sort-descending-line" size={16} />
          <span data-sort-label>By Relevance</span>
          <Icon name="chevron-down" size={14} />
        </button>
        <button
          data-dropdown-item="relevance"
          class="pub-sort-option"
          aria-selected="true"
        >
          By Relevance
        </button>
        <button
          data-dropdown-item="year"
          class="pub-sort-option"
          aria-selected="false"
        >
          By Year
        </button>
      </Dropdown>
    </div>

    {allKeywords.length > 0 && (
        <div
          class="chip-filter-bar"
          role="group"
          aria-label="Filter publications by tag"
        >
          {allKeywords.map(({ keyword, count }) => (
            <TaxonomyChip
              label={keyword}
              count={count}
              countNoun="publication"
              data-pub-tag-filter={slugify(keyword)}
              aria-pressed="false"
              aria-label={`Filter publications by ${keyword}; ${formatCount(count, "publication")}`}
            />
          ))}
          <span class="chip-active-filter" data-active-filter hidden>
            <TaxonomyChip
              label="Clear"
              prefix="×"
              tone="destructive"
              data-clear-filter
              aria-label="Clear publication filter"
            />
          </span>
          <span
            class="sr-only"
            aria-live="polite"
            aria-atomic="true"
            data-publication-filter-status
          />
        </div>
    )}
    {equalContributionNote && (
        <p class="equal-contribution-note" set:html={equalContributionNote} />
      )}
  </div>

  <!-- Relevance view (default visible) -->
  <div data-pub-view="relevance">
    {allPublicationsFlat.length > 0 ? (
        <CardGroup>
          {allPublicationsFlat.map((pub: ProcessedPublication) => <PubCard pub={pub} />)}
        </CardGroup>
      ) : (
        <div class="empty-state">
          <h2>No publications found</h2>
          <p>No publications yet.</p>
        </div>
      )}
  </div>

  <!-- Year view (hidden by default) -->
  <div data-pub-view="year" hidden>
    {years.length > 0 ? (
        years.map((year) => (
          <div data-pub-year-section={year}>
            <Section title={year.toString()}>
              <CardGroup>
                {publicationsByYear[year].map((pub: ProcessedPublication) => (
                  <PubCard pub={pub} />
                ))}
              </CardGroup>
            </Section>
          </div>
        ))
      ) : (
        <div class="empty-state">
          <h2>No publications found</h2>
          <p>No publications yet.</p>
        </div>
      )}
  </div>

  {presentations.length > 0 && (
      <Section title="Presentations">
        <PresentationTimeline entries={presentations} />
      </Section>
    )}
</CommonLayout>

<script>
  import { initChipFilter } from "@/lib/chip-filter"

  function initPublicationControls() {
    const relevanceView = document.querySelector<HTMLElement>(
      '[data-pub-view="relevance"]',
    )
    const yearView = document.querySelector<HTMLElement>(
      '[data-pub-view="year"]',
    )
    const sortLabel = document.querySelector<HTMLElement>("[data-sort-label]")
    const sortOptions = document.querySelectorAll<HTMLElement>(
      "#pub-sort-dropdown [data-dropdown-item]",
    )

    if (!relevanceView || !yearView) return

    // astro:page-load and astro:after-swap both fire per navigation; skip the
    // second call so we don't double-bind listeners on this DOM instance
    if (relevanceView.dataset.controlsInitialized === "true") return
    relevanceView.dataset.controlsInitialized = "true"

    let currentSort = "relevance"

    const chipFilter = initChipFilter({
      itemSelector: "[data-pub-keywords]",
      itemAttr: "pubKeywords",
      filterButtonSelector: "[data-pub-tag-filter]",
      filterButtonAttr: "pubTagFilter",
      groupSelector: "[data-pub-year-section]",
      clearButtonSelector: "[data-clear-filter]",
      activeIndicatorSelector: "[data-active-filter]",
      statusSelector: "[data-publication-filter-status]",
      getScope: () =>
        currentSort === "relevance" ? relevanceView! : yearView!,
    })

    function switchSort(mode: string) {
      currentSort = mode

      if (mode === "relevance") {
        relevanceView!.hidden = false
        yearView!.hidden = true
      } else {
        relevanceView!.hidden = true
        yearView!.hidden = false
      }

      if (sortLabel) {
        sortLabel.textContent =
          mode === "relevance" ? "By Relevance" : "By Year"
      }

      sortOptions.forEach((opt) => {
        opt.setAttribute(
          "aria-selected",
          opt.dataset.dropdownItem === mode ? "true" : "false",
        )
      })

      chipFilter.applyFilter()
    }

    // Sort dropdown clicks
    sortOptions.forEach((opt) => {
      opt.addEventListener("click", () => {
        const value = opt.dataset.dropdownItem
        if (value) switchSort(value)
      })
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPublicationControls, {
      once: true,
    })
  } else {
    initPublicationControls()
  }
  document.addEventListener("astro:page-load", initPublicationControls)
  document.addEventListener("astro:after-swap", initPublicationControls)
</script>

<style>
  .pub-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .publication-intro,
  .equal-contribution-note,
  .empty-state {
    color: var(--muted-foreground);
  }

  .publication-scholar-link {
    color: var(--foreground);
  }

  .equal-contribution-note {
    inline-size: 100%;
    font-size: var(--step--1);
  }

  .empty-state {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .empty-state h2 {
    margin-block: 0 var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
  }

  .pub-sort-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--background);
    color: var(--foreground);
    cursor: pointer;
    transition:
      border-color var(--motion-duration) var(--motion-ease),
      box-shadow var(--motion-duration) var(--motion-ease);
  }

  .pub-sort-trigger:hover {
    border-color: var(--primary);
    box-shadow: 0 0.25rem 0.75rem
      color-mix(in oklab, var(--foreground) 8%, transparent);
  }

  #pub-sort-dropdown {
    background: var(--background);
  }

  .pub-sort-option {
    font-size: 0.875rem;
  }

  .pub-sort-option[aria-selected="true"] {
    color: var(--primary-foreground);
    font-weight: var(--font-weight-semibold);
  }

  [data-pub-view][hidden],
  .chip-active-filter[hidden] {
    display: none;
  }
</style>
