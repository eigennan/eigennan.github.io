---
import { findFunApp } from "@/lib/fun/registry"
import CommonLayout from "@/layouts/CommonLayout.astro"
import OrderOfIntegration from "@/components/fun/OrderOfIntegration.astro"

const app = findFunApp("order-of-integration")
---

<CommonLayout
  title={app.title}
  description={app.blurb}
  prose={false}
  breadcrumbs={[
    { label: "Fun", href: "/fun", icon: "mingcute:sparkles-line" },
    { label: app.title, icon: app.icon },
  ]}
>
  <OrderOfIntegration />
</CommonLayout>
