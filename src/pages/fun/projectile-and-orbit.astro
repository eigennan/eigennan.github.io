---
import { findFunApp } from "@/lib/fun/registry"
import CommonLayout from "@/layouts/CommonLayout.astro"
import ProjectileAndOrbit from "@/components/fun/ProjectileAndOrbit.astro"

const app = findFunApp("projectile-and-orbit")
---

<CommonLayout
  title={app.title}
  description={app.blurb}
  prose={false}
  breadcrumbs={[
    { label: "Fun", href: "/fun", icon: "mingcute:sparkles-line" },
    { label: app.title, icon: app.icon },
  ]}
>
  <ProjectileAndOrbit />
</CommonLayout>
