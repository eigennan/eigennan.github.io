---
import { findFunApp } from "@/lib/fun/registry"
import CommonLayout from "@/layouts/CommonLayout.astro"
import WorkAndCirculation from "@/components/fun/WorkAndCirculation.astro"

const app = findFunApp("work-and-circulation")
---

<CommonLayout
  title={app.title}
  description={app.blurb}
  prose={false}
  breadcrumbs={[
    { label: "Fun", href: "/fun", icon: "mingcute:sparkles-line" },
    { label: app.title, icon: app.icon },
  ]}
>
  <WorkAndCirculation />
</CommonLayout>
