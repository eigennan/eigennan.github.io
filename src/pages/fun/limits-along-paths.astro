---
import { findFunApp } from "@/lib/fun/registry"
import CommonLayout from "@/layouts/CommonLayout.astro"
import LimitsAlongPaths from "@/components/fun/LimitsAlongPaths.astro"

const app = findFunApp("limits-along-paths")
---

<CommonLayout
  title={app.title}
  description={app.blurb}
  prose={false}
  breadcrumbs={[
    { label: "Fun", href: "/fun", icon: "mingcute:sparkles-line" },
    { label: app.title, icon: app.icon },
  ]}
>
  <LimitsAlongPaths />
</CommonLayout>
